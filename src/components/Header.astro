---
import Search from "@astrojs/starlight/components/Search.astro";
import SocialIcons from "@astrojs/starlight/components/SocialIcons.astro";
import logo from "../assets/logo.svg";

const base = import.meta.env.BASE_URL;
const links = [
  { label: "首頁", href: base },
  { label: "文章", href: `${base}#archive` },
  { label: "專案", href: "https://vdustr.github.io/projects" },
  { label: "關於", href: "https://vdustr.github.io" },
  { label: "RSS", href: `${base}rss.xml` },
];
---

<header class="site-header">
  <div class="header-brand">
    <a href={base} aria-label="VDUSTR 首頁"><img src={logo.src} width="264" height="56" alt="VDUSTR" /></a>
  </div>
  <nav class="desktop-nav" aria-label="主要導覽">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
  <div class="header-tools">
    <Search />
    <SocialIcons />
  </div>
</header>
