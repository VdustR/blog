{
  "name": "blog",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "verify:output": "node scripts/check-built-links.mjs",
    "preview": "astro preview",
    "audit": "pnpm audit --prod",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "security:check": "pnpm run audit",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/starlight": "0.41.7",
    "astro": "7.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "typescript": "6.0.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": "11.22.0"
  },
  "packageManager": "pnpm@11.22.0"
}
